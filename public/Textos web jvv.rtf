\pard\pardeftab720\partightenfactor0

\fs48 \cf0 \cb2 Actriz \'b7 C\'f3mica \'b7 Vedette \'b7 Empresaria \'b7 Presentadora \'b7 Dinamizadora Cultural\cb1 \
